var ForterLogger = require('*/cartridge/scripts/lib/forter/forterLogger');
var currentSite = require("dw/system/Site").getCurrent();

/**
 * ForterConfig object contains all configuration data,
 * which are used to call and use the Forter service.
 * This data is retrieved from custom site preferences.
 *
 * To include this script use:
 * var config = require('~/cartridge/scripts/lib/forter/forterConfig.ds').ForterConfig;
 */
function ForterConfig() {
    this.forterLogger = new ForterLogger("ForterConfig.ds");
    var forterSitePreferences = currentSite.getPreferences().getCustom();

    this.forterEnabled = forterSitePreferences.forterEnabled;
    this.forterSiteID = forterSitePreferences.forterSiteID;
    this.forterSecretKey = forterSitePreferences.forterSecretKey;
    this.forterShowDeclinedPage = forterSitePreferences.forterShowDeclinedPage;
    this.forterCustomDeclineMessage = forterSitePreferences.forterCustomDeclineMessage;
    this.forterAutoInvoiceOnApprove = forterSitePreferences.forterAutoInvoiceOnApprove;
    this.forterCancelOrderOnDecline = forterSitePreferences.forterCancelOrderOnDecline;
    this.forterWeeksAmount = forterSitePreferences.forterWeeksAmount;
    this.forterAbusePolicySettingsEnabled = forterSitePreferences.forterAbusePolicySettingsEnabled;
    this.forterMerchantPolicyReshipper = forterSitePreferences.forterMerchantPolicyReshipper.value;
    this.forterMerchantPolicyReshipperMessage = forterSitePreferences.forterMerchantPolicyReshipperMessage;
    this.forterMerchantPolicyCheckoutINR = forterSitePreferences.forterMerchantPolicyCheckoutINR.value;
    this.forterMerchantPolicyCheckoutINRMessage = forterSitePreferences.forterMerchantPolicyCheckoutINRMessage;
    this.forterMerchantPolicyCheckoutReturns = forterSitePreferences.forterMerchantPolicyCheckoutReturns.value;
    this.forterMerchantPolicyCheckoutReturnsMessage = forterSitePreferences.forterMerchantPolicyCheckoutReturnsMessage;
    this.forterMerchantPolicyPromotionAbuse = forterSitePreferences.forterMerchantPolicyPromotionAbuse.value;
    this.forterMerchantPolicyPromotionAbuseMessage = forterSitePreferences.forterMerchantPolicyPromotionAbuseMessage;
    this.forterMerchantPolicyLimitedItemAbuse = forterSitePreferences.forterMerchantPolicyLimitedItemAbuse.value;
    this.forterMerchantPolicyLimitedItemAbuseMessage = forterSitePreferences.forterMerchantPolicyLimitedItemAbuseMessage;
    this.forterMerchantPolicyReseller = forterSitePreferences.forterMerchantPolicyReseller.value;
    this.forterMerchantPolicyResellerMessage = forterSitePreferences.forterMerchantPolicyResellerMessage;

    this.STATUS_APPROVED     = "APPROVED";
    this.STATUS_DECLINED     = "DECLINED";
    this.STATUS_NOT_REVIEWED = "NOT_REVIEWED";
    this.STATUS_FAILED       = "FAILED";
    this.STATUS_NOT_SENT     = "NOT_SENT";

    this.CUSTOMER_LOGIN          = "LOGIN";
    this.CUSTOMER_LOGOUT         = "LOGOUT";
    this.CUSTOMER_CREATE         = "REGISTRATION";
    this.CUSTOMER_PROFILE_UPDATE = "UPDATE";
    this.CUSTOMER_ADDRESS_UPDATE = "ADDRESS_UPDATE";
    this.CUSTOMER_PAYMENT_UPDATE = "PAYMENT_METHOD_UPDATE";

    this.PHONE_TYPE_PRIMARY   = "Primary";
    this.PHONE_TYPE_SECONDARY = "Secondary";

    this.PHONE_DESC_HOME   = "Home";
    this.PHONE_DESC_WORK   = "Work";
    this.PHONE_DESC_MOBILE = "Mobile";
}

ForterConfig.prototype.saveSiteCredentials = function() {
    currentSite.setCustomPreferenceValue("forterSiteID", this.forterSiteID);
    currentSite.setCustomPreferenceValue("forterSecretKey", this.forterSecretKey);
}

ForterConfig.prototype.saveSitePreferences = function() {
    currentSite.setCustomPreferenceValue("forterEnabled", this.forterEnabled);
    currentSite.setCustomPreferenceValue("forterShowDeclinedPage", this.forterShowDeclinedPage);
    currentSite.setCustomPreferenceValue("forterCustomDeclineMessage", this.forterCustomDeclineMessage);
    currentSite.setCustomPreferenceValue("forterAutoInvoiceOnApprove", this.forterAutoInvoiceOnApprove);
    currentSite.setCustomPreferenceValue("forterCancelOrderOnDecline", this.forterCancelOrderOnDecline);
    currentSite.setCustomPreferenceValue("forterWeeksAmount", this.forterWeeksAmount);
}

ForterConfig.prototype.saveAbusePolicyPreferences = function() {
    currentSite.setCustomPreferenceValue("forterAbusePolicySettingsEnabled", this.forterAbusePolicySettingsEnabled);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyReshipper", this.forterMerchantPolicyReshipper);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyReshipperMessage", this.forterMerchantPolicyReshipperMessage);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyCheckoutINR", this.forterMerchantPolicyCheckoutINR);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyCheckoutINRMessage", this.forterMerchantPolicyCheckoutINRMessage);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyCheckoutReturns", this.forterMerchantPolicyCheckoutReturns);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyCheckoutReturnsMessage", this.forterMerchantPolicyCheckoutReturnsMessage);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyPromotionAbuse", this.forterMerchantPolicyPromotionAbuse);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyPromotionAbuseMessage", this.forterMerchantPolicyPromotionAbuseMessage);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyLimitedItemAbuse", this.forterMerchantPolicyLimitedItemAbuse);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyLimitedItemAbuseMessage", this.forterMerchantPolicyLimitedItemAbuseMessage);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyReseller", this.forterMerchantPolicyReseller);
    currentSite.setCustomPreferenceValue("forterMerchantPolicyResellerMessage", this.forterMerchantPolicyResellerMessage);
}

Object.freeze(ForterConfig);
module.exports.ForterConfig = new ForterConfig();
